PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ai-meal-planner
JWT_SECRET=replace-with-a-long-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-token-secret

# AI provider options:
# AI_PROVIDER=gemini
# AI_PROVIDER=openai
# AI_PROVIDER=openai-compatible
AI_PROVIDER=gemini
AI_API_KEY=replace-with-your-ai-provider-api-key
AI_MODEL=gemini-2.0-flash

# Optional for OpenAI-compatible providers, proxies, or local gateways.
# AI_BASE_URL=https://api.openai.com/v1

# Backward-compatible Gemini variables still work if AI_API_KEY/AI_MODEL are not set.
GEMINI_API_KEY=
GEMINI_MODEL=
